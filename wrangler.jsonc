{
  // Static-assets Worker: serve the files in this repo, plus one tiny script
  // (worker.js) that answers the Google Search Console verification path with
  // a 200 — the assets router would otherwise 307 "*.html" to the extensionless
  // URL, and Google's verifier does not follow redirects.
  // Cloudflare's "Workers Builds" pipeline runs `npx wrangler deploy`, which reads this.
  "name": "rachelwrites",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  // Non-secret config for the reading-list funnel. The Resend API key is a
  // secret: set it in the dashboard (Workers → rachelwrites → Settings →
  // Variables and Secrets → RESEND_API_KEY) or `npx wrangler secret put RESEND_API_KEY`.
  "vars": {
    "READING_LIST_DOWNLOAD_URL": "https://drive.google.com/uc?export=download&id=1ajmWr9mFpPf7vewSfTkmAuKAWlrlMUCp",
    "READING_LIST_SEGMENT_ID": "d1b8c9eb-4a47-433f-8667-211e7b53c939",
    "MAIL_FROM": "Rachel Fletcher <hello@rachelfletcherwrites.com>",
    // Every signup sends a notification email here. Empty = no notifications.
    "NOTIFY_TO": "",
    // Server-side Substack subscribe is OFF: Substack's subscribe endpoint sits
    // behind a JS challenge (403 from servers, Aug 2026). Instead, the success
    // state + delivery email link to /subscribe?email=… (one click, prefilled).
    "SUBSTACK_SYNC": "off",
    "SUBSTACK_URL": "https://rachelfletcher.substack.com"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
